<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net4.6.1</TargetFrameworks>
        <Authors>.NET Foundation and Contributors</Authors>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/dotnet/Silk.NET</PackageProjectUrl>
        <Description>Multi-platform native library for ANGLE.</Description>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://chromium.googlesource.com/angle/angle</RepositoryUrl>
    </PropertyGroup>

    <!-- The default item globs would claim these as @(None). They are handed to the consumer through
         @(Content) instead, below, and an item in both would be copied twice. -->
    <ItemGroup>
        <None Remove="runtimes\**\*" />
    </ItemGroup>

    <!--
        The ANGLE libraries, handed to whatever consumes this project.

        This project produces no assembly - it is the binaries plus a copy step. A ProjectReference
        to it therefore carries nothing by default, because a project reference passes along an
        assembly and that assembly's copy-to-output items; with no assembly and the libraries laid
        out under runtimes/, NuGet's convention rather than MSBuild's, the consumer got no libEGL
        and no libGLESv2 at all, and SDL_GL_CreateContext failed with "Could not initialize OpenGL /
        GLES library". The Content items below are what makes the reference functional rather than
        merely valid: they carry the CopyToOutputDirectory that schedules the copy and the Link that
        puts both files in the consumer's output root.

        Flat in the root rather than under runtimes/<rid>/native/, because that is where a loader
        looks for a bare library name. NuGet's own RID handling, which does use that layout, only
        applies to a RID-specific build of the consumer, and this consumer is RID-less; EGL.GetApi
        and SDL both ask for "libGLESv2" by name.

        It has to run inside a target, because neither of the two things it needs exists earlier.
        @(Content) is read by AssignTargetPaths as it builds @(ContentWithTargetPath), so adding to
        it at evaluation time is not enough - and an evaluation-time wildcard could not be given
        the metadata either, since Metadata attributes apply only to the item they are written on,
        which for a wildcard is the pattern and not what it expands to. $(RuntimeIdentifier) is the
        other: a ProjectReference is resolved with its properties already set, so the RID the
        consumer asked for does reach this project, but not before evaluation.
    -->
    <Target Name="AngleNativeLayout" BeforeTargets="AssignTargetPaths">
        <PropertyGroup>
            <!-- A build that named a RID means it - but it cannot be read from $(RuntimeIdentifier)
                 here. When the SDK collects a project's copy-to-output items it invokes the project
                 with the RID stripped from its properties, so a consumer's -r linux-x64 arrives as
                 an empty RuntimeIdentifier and this project would fall back to the host and copy
                 Windows DLLs into a linux-x64 output directory. Measured, not assumed: under -r
                 linux-x64 both RuntimeIdentifier and the host are visible here and only the latter
                 has a value. RuntimeIdentifier stays as a fallback for a direct reference to this
                 project, and the consumer passes AngleNativeRid to say what it is targeting.

                 NETCoreSdkRuntimeIdentifier is the last fallback and describes the machine doing the
                 build, which is the best available answer: a RID-less build is one for the host, and
                 that is the only platform it can be built for. Not every RID names a directory here
                 either: the package ships one universal macOS build, so both of its RIDs fold onto
                 osx. A RID outside the set matches nothing and so copies nothing, which is the
                 honest outcome when there are no binaries for it. -->
            <_AngleNativeRid Condition="'$(_AngleNativeRid)' == ''">$(AngleNativeRid)</_AngleNativeRid>
            <_AngleNativeRid Condition="'$(_AngleNativeRid)' == ''">$(RuntimeIdentifier)</_AngleNativeRid>
            <_AngleNativeRid Condition="'$(_AngleNativeRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_AngleNativeRid>
            <_AngleNativeRid Condition="'$(_AngleNativeRid)' == 'osx-x64' Or '$(_AngleNativeRid)' == 'osx-arm64'">osx</_AngleNativeRid>

            <!-- The library names follow the platform, not the architecture: every Windows RID ships
                 .dll, both Linux ones .so, and macOS .dylib. Read off the RID directory rather than
                 from RuntimeInformation, which would describe the machine doing the build and so
                 answer for the wrong platform on a cross-targeted one. -->
            <_AngleNativeExt Condition="$(_AngleNativeRid.StartsWith('win'))">.dll</_AngleNativeExt>
            <_AngleNativeExt Condition="$(_AngleNativeRid.StartsWith('linux'))">.so</_AngleNativeExt>
            <_AngleNativeExt Condition="$(_AngleNativeRid.StartsWith('osx'))">.dylib</_AngleNativeExt>

            <!-- The Vulkan loader has a name and an extension of its own, so neither of the two
                 properties above fits it and it gets both spelled out.

                 The name is Windows-specific, vulkan-1.dll against everyone else's libvulkan, and the
                 extension is not the platform's either: Linux emits it as libvulkan.so.1, because
                 the libvulkan target sets output_extension = "so.1"
                 (third_party/vulkan-loader/src/BUILD.gn). A search for libvulkan.so on Linux
                 therefore finds nothing and reads as "there is no loader", which is the same
                 false conclusion the Windows side of this once produced.

                 Empty on macOS on purpose, and that is not an omission: angle_shared_libvulkan is
                 !is_mac, so a macOS build links the loader statically and there is no file to copy.
                 The Exists() guards below then find nothing, which is the correct outcome there. -->
            <_AngleVulkanName Condition="$(_AngleNativeRid.StartsWith('win'))">vulkan-1.dll</_AngleVulkanName>
            <_AngleVulkanName Condition="$(_AngleNativeRid.StartsWith('linux'))">libvulkan.so.1</_AngleVulkanName>
        </PropertyGroup>

        <ItemGroup>
            <!-- Exists() guards each item, because a missing Include here is not a skipped copy but
                 MSB3030, which fails the consumer's build. That matters for win-arm64 in particular:
                 the RID is supported and its binaries are built, but they reach the repository from
                 a CI job that commits them, so a checkout taken between those two points would
                 otherwise break every Windows arm64 build that referenced this project. -->
            <Content Include="runtimes\$(_AngleNativeRid)\native\libEGL$(_AngleNativeExt)" Condition="'$(_AngleNativeRid)' != '' And Exists('runtimes\$(_AngleNativeRid)\native\libEGL$(_AngleNativeExt)')">
                <Link>libEGL$(_AngleNativeExt)</Link>
                <CopyToOutputDirectory>Always</CopyToOutputDirectory>
                <Visible>false</Visible>
            </Content>
            <Content Include="runtimes\$(_AngleNativeRid)\native\libGLESv2$(_AngleNativeExt)" Condition="'$(_AngleNativeRid)' != '' And Exists('runtimes\$(_AngleNativeRid)\native\libGLESv2$(_AngleNativeExt)')">
                <Link>libGLESv2$(_AngleNativeExt)</Link>
                <CopyToOutputDirectory>Always</CopyToOutputDirectory>
                <Visible>false</Visible>
            </Content>

            <!-- The Vulkan loader, which has to sit next to libGLESv2 rather than merely somewhere on
                 the loader path. ANGLE does not link it: OpenLibVulkan resolves it at run time
                 (src/common/vulkan/libvulkan_loader.cpp) and angle_use_custom_libvulkan, which is true
                 on Windows, selects SearchType::ModuleDir over SearchType::SystemDir. So its directory
                 is the whole of the search, and the system loader that already exists in System32 does
                 not count.

                 Missing it is silent and misdiagnosed. ANGLE reports the failed load as
                 VK_ERROR_INITIALIZATION_FAILED, which reaches the caller as
                   Internal Vulkan error (-3): Initialization of an object could not be completed for
                   implementation-specific reasons, in vk_renderer.cpp, rx::vk::Renderer::initialize:2491
                 (that line is the ANGLE_VK_CHECK on OpenLibVulkan's result), so it blames the driver
                 for an absent file, and everything about the Vulkan backend reads as broken when only
                 this copy is. The macOS argument to the name property above explains why the guard is
                 expected to match nothing there. -->
            <Content Include="runtimes\$(_AngleNativeRid)\native\$(_AngleVulkanName)" Condition="'$(_AngleVulkanName)' != '' And Exists('runtimes\$(_AngleNativeRid)\native\$(_AngleVulkanName)')">
                <Link>$(_AngleVulkanName)</Link>
                <CopyToOutputDirectory>Always</CopyToOutputDirectory>
                <Visible>false</Visible>
            </Content>
        </ItemGroup>
    </Target>
</Project>
