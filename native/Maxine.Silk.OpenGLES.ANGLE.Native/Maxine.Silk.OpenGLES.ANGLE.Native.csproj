<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net4.6.1</TargetFrameworks>

        <!-- No assembly is produced; this package is nothing but native binaries plus a targets
             file that copies the right ones next to the consuming application. -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsPackable>true</IsPackable>

        <!-- The root Directory.Build.props turns on a .snupkg for the binding packages, which have
             assemblies to symbol-ise. This project has none, so the symbols package comes out empty
             and pack fails with NU5017 ("no dependencies nor content") after the real .nupkg has
             already been written, so the error reads as if the whole package were broken. -->
        <IncludeSymbols>false</IncludeSymbols>

        <!-- The root Directory.Build.props sets Version to the Silk.NET 2.x version these bindings
             track; native packages are versioned by build date like the ones in the Silk.NET
             monorepo, since the binaries change independently of the bindings. This deliberately
             overrides the root, and is set explicitly rather than derived from a submodule's
             commit date because there is no ANGLE checkout here — the binaries are fetched from
             ANGLE's source at build time. -->
        <Version>2026.9.23</Version>
        <Authors>.NET Foundation and Contributors</Authors>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
        <Description>Multi-platform native library for ANGLE.</Description>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://chromium.googlesource.com/angle/angle</RepositoryUrl>
        <PackageProjectUrl>https://github.com/uwx/Maxine.Silk.EGL</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <!-- Native assets, resolved by RID at restore time. -->
        <Content Include="runtimes/**" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />

        <!-- The targets file maps the current OS/architecture onto a RID directory and copies the
             matching libraries into the build output. Shipped under both build/ and
             buildTransitive/ so it also applies to projects that reference this one indirectly. -->
        <Content Include="build/**" PackagePath="build/%(RecursiveDir)%(Filename)%(Extension)" />
        <Content Include="build/**" PackagePath="buildTransitive/%(RecursiveDir)%(Filename)%(Extension)" />

        <!-- Zeros-length placeholders declaring the supported TFMs. -->
        <Content Include="$(MSBuildThisFileDirectory)..\_._" PackagePath="lib/net461" />
        <Content Include="$(MSBuildThisFileDirectory)..\_._" PackagePath="lib/netstandard2.0" />
    </ItemGroup>

</Project>
