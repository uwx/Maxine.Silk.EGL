root = true

[*.cs]
# SilkTouch analyzer options. These are not optional: without
# silk_touch_vtable_generate + silk_touch_sealed_vtable_creation, SilkTouch raises
# ST0002 FORCE-USE-VTABLE for every partial method on a non-sealed class and the
# build fails outright.
silk_touch_vtable_generate = true
silk_touch_vtable_tree_emit_assert = true
silk_touch_sealed_vtable_creation = true
silk_touch_vtable_preload = false
silk_touch_telemetry = false
silk_touch_compact_file_format = true
